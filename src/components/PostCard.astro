---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"tech"> | CollectionEntry<"hiker">;
  base: string;
}

const { post, base } = Astro.props;

const href = `${base}/${post.id}`;

const date = new Date(post.data.pubDate);
const dateLabel = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const dateISO = date.toISOString().slice(0, 10);

const updatedDate = post.data.updatedDate
  ? new Date(post.data.updatedDate)
  : undefined;

const updatedLabel = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const updatedISO = updatedDate?.toISOString().slice(0, 10);
---

<li class="post-card">
  <a class="post-card__link" href={href}>
    <h2 class="post-card__title">{post.data.title}</h2>
  </a>

  <p class="post-card__meta">
    <time datetime={dateISO}>{dateLabel}</time>

    {updatedDate && updatedISO && (
      <span class="post-card__updated text-blue-700 dark:text-blue-300">
        · Updated
        <time datetime={updatedISO}>{updatedLabel}</time>
      </span>
    )}
  </p>

  <p class="post-card__excerpt">{post.data.description}</p>

  {post.data.tags.length > 0 && (
    <ul class="post-card__tags" aria-label="Tags">
      {post.data.tags.map((t) => (
        <li class="tag">{t}</li>
      ))}
    </ul>
  )}
</li>

