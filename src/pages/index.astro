---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getFeaturedPosts } from "../lib/featured";

const featuredPosts = await getFeaturedPosts(6);
const sectionBase: Record<string, string> = {
  tech: "/blog/tech",
  hiker: "/blog/hiker",
};

const title = "Featured posts";
const description = "Selected posts from both blogs.";
---

<Layout {title} {description}>
  <header class="blog-head">
    <h1 class="page__title">{title}</h1>
    <p class="blog-head__sub">{description}</p>
  </header>

  <ul class="post-list">
    {featuredPosts.map((post) => (
      <PostCard post={post} base={sectionBase[post.collection]} />
    ))}
  </ul>
</Layout>
