---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search the site">
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

    <div class="mx-auto! max-w-5xl! px-4!">
        <h1 class="text-3xl mb-6!">Search the site</h1>
            <div id="search-page-container"></div>
    </div>

    <style is:global>

      .search-page-wrapper {
        margin-left: auto !important;
        margin-right: auto !important;
        max-width: 64rem !important;
        padding-left: 1rem !important;
        padding-right: 1rem !important;
        padding-top: 4rem !important;
        padding-bottom: 4rem !important;
      }

      .pagefind-ui .pagefind-ui__form {
        margin: 0 auto !important;
        max-width: 48rem !important;
      }

      .pagefind-ui .pagefind-ui__status {
        text-align: center !important;
      }

      html[data-theme="dark"] {
        --pagefind-ui-text: #e2e8f0;
        --pagefind-ui-title: #ffffff;
        --pagefind-ui-background: #1e293b;
        --pagefind-ui-border: #334155;
        --pagefind-ui-primary: #38bdf8;
      }

      html[data-theme="dark"] .pagefind-ui__button {
        background-color: #1e293b !important;
        color: #ffffff !important;
        border-color: #334155 !important;
      }

      html[data-theme="dark"] .pagefind-ui__button:hover {
        background-color: #334155 !important;
      }
    </style>

    <script is:inline>
      function loadPagefind() {
        const container = document.querySelector('#search-page-container');

        if (container && !container.querySelector('.pagefind-ui')) {
          const pagefindPath = "/pagefind/";
          const script = document.createElement('script');
          script.src = pagefindPath + "pagefind-ui.js";

          script.onload = () => {
            if (typeof PagefindUI !== 'undefined') {
              new PagefindUI({
                element: "#search-page-container",
                showImages: true,
                bundlePath: pagefindPath,
                translations: {
                  placeholder: "Enter a keyword...",
                  clear_search: "Clearing",
                  load_more: "Load more results",
                  search_label: "Search the site",
                  filters_label: "Filters",
                  zero_results: "No results were found for [SEARCH_TERM]",
                  many_results: "Have been found [COUNT] results for [SEARCH_TERM]",
                  one_result: "One result found for [SEARCH_TERM]"
                }
              });
            }
          };

          script.onerror = () => {
            console.warn("The folder /pagefind/ was not found on path: " + pagefindPath);
            container.innerHTML = "<p style='color: #666;'>The search engine is preparing for compilation... (Available only in production mode)</p>";
          };

          document.head.appendChild(script);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadPagefind);
      } else {
        loadPagefind();
      }
      document.addEventListener("astro:after-swap", loadPagefind);
    </script>
</Layout>
