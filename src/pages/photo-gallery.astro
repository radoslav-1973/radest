---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe.svelte";
import { photos } from "../data/favorite-photos";
import PublicPhotoGallery from "../components/PublicPhotoGallery.astro";
import GalleryFallbackLinks from "../components/GalleryFallbackLinks.svelte";
---

<Layout title="Photo Gallery" description="A collection of photos">
<div class="mx-auto max-w-5xl px-4">
	<h1 class="gallery-label">Photo Gallery</h1>
	    <GalleryFallbackLinks />
	<h3 class="gallery-label">Favorite Photos</h3>
        <PublicPhotoGallery photos={photos} />
	<h3 class="gallery-label">Explore the map and select a label to open photographs from that place.</h3>
    	<Globe client:idle />
</div>
</Layout>
