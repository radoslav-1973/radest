{
  "name": "radest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/strip-unreferenced-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "setup": "npm run gen:brand && npm run gen:icons && npm run gen:placeholders",
    "gen:brand": "node scripts/generate-brand.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/eb-garamond": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "lucide-svelte": "^1.0.1",
    "maplibre-gl": "^6.9.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.45.0",
    "@types/geojson": "^7946.0.16",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.6.1",
    "tailwind-merge": "^3.6.0",
